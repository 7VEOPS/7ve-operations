{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hq.7virtuesentertainment.com"
        }
      ],
      "destination": "/staffing/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tech.7virtuesentertainment.com"
        }
      ],
      "destination": "/tech/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/irs/fw9.pdf",
      "destination": "https://www.irs.gov/pub/irs-pdf/fw9.pdf"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hq.7virtuesentertainment.com"
        }
      ],
      "destination": "/staffing/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tech.7virtuesentertainment.com"
        }
      ],
      "destination": "/tech/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
